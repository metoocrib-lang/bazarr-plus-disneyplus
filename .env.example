# Genera dos valores distintos en tu terminal y copia este archivo a .env.
# No pongas aquí tu contraseña Disney+ ni publiques el .env resultante.
# Token compartido con el proveedor: mínimo 32 caracteres.
BRIDGE_API_TOKEN=
# Contraseña del escritorio noVNC: mínimo 12 caracteres.
VNC_PASSWORD=
# Puerto libre en el host; solo se publica en 127.0.0.1.
NOVNC_PORT=6082
